    <!-- Setup -->
    <string name="setup_title">One thing first</string>
    <string name="setup_explanation">Breadbin needs the three ROMs from a Commodore 64: BASIC, the KERNAL and the character set. They are still Commodore\'s copyright, so they are not part of this app and you have to supply them.</string>
    <string name="setup_where">If you own a C64 you can read them off it. Otherwise they come with VICE, the desktop emulator, as basic, kernal and chargen.</string>
    <string name="setup_pick">Choose ROM files</string>
    <string name="setup_pick_hint">Pick all three at once, or one at a time — Breadbin works out which is which.</string>
