<?xml version="1.0" encoding="utf-8"?>
<!--
  The library and the settings are worth carrying to a new phone. The ROMs are not: they are not
  ours to copy around, and only what is listed here is backed up, so leaving them out is enough.
-->
<full-backup-content>
    <include domain="file" path="media/" />
    <!-- Where the settings really live: preferencesDataStore("settings") writes under
         files/datastore/, which "sharedpref" does not cover. Without this line the comment above
         was a statement of intent that the rules did not carry out — the library travelled and
         every setting reset itself on the new phone. -->
    <include domain="file" path="datastore/" />
    <include domain="sharedpref" path="." />
</full-backup-content>
